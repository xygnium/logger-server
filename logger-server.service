# systemd user service for the logger server. Installation: see README.md.
# Assumes the repo is cloned at ~/dev/github/logger-server; change the paths
#   below if it isn't.

[Unit]
Description=Data logger UDP server (logger-server)

[Service]
WorkingDirectory=%h/dev/github/logger-server
ExecStart=/usr/bin/python3 -u %h/dev/github/logger-server/udp_listener.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
